# Server-only Neon Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth secret; use at least 32 high-entropy characters in each environment.
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Public canonical URL used by future client-facing auth and booking links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional deployment credentials. Prefer `wrangler login` for local deployment.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
